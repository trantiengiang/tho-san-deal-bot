# Copy this file to .env and fill in your values
# NEVER commit .env to version control

SERVER_PORT=8080

# Database
DB_URL=jdbc:postgresql://postgres:5432/thosandeal
DB_USERNAME=thosandeal
DB_PASSWORD=change_me_db_password

# Telegram
TELEGRAM_BOT_TOKEN=change_me_bot_token
TELEGRAM_WEBHOOK_SECRET=change_me_webhook_secret
TELEGRAM_NOTIFICATION_CHANNEL_ID=change_me_channel_id
# Optional: comma-separated Telegram User IDs allowed to use the bot (empty = allow all)
TELEGRAM_ALLOWED_USER_IDS=

# Scheduler
PRICE_CHECK_INTERVAL_MS=60000
NOTIFICATION_OUTBOX_INTERVAL_MS=15000

# MockPriceProvider - configurable final price for testing
MOCK_FINAL_PRICE=1490000
